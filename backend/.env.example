# Copy to backend/.env; use absolute paths on the computer running this service.
# Keep the entire whisper.cpp build/bin directory (its shared libraries are needed).
WHISPER_CLI=/absolute/path/to/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/absolute/path/to/models/ggml-base.bin
WHISPER_LANGUAGE=en
HOST=127.0.0.1
PORT=3000
